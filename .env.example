# ── 서버 ──────────────────────────────────────────────
PORT=3000
WEB_ORIGIN=http://localhost:5173

# ── Postgres (docker-compose.yml 기본값과 동일) ─────────
DATABASE_URL=postgres://zipzom:zipzom@localhost:5433/zipzom

# ── 공공데이터포털 (data.go.kr) ───────────────────────
# 1) https://www.data.go.kr 회원가입·로그인
# 2) 아래 4개 API 각각 [활용신청] (개발계정 자동승인, 1~2시간 후 활성)
#    - 국토교통부_마이홈포털 공공주택 모집공고 조회 서비스  https://www.data.go.kr/data/15108420/openapi.do
#    - 국토교통부_마이홈포털 공공임대주택 단지정보 조회 서비스 https://www.data.go.kr/data/15110581/openapi.do
#    - 한국토지주택공사_분양임대공고문 조회 서비스          https://www.data.go.kr/data/15058530/openapi.do
#    - 한국토지주택공사_분양임대공고별 상세정보 조회 서비스   https://www.data.go.kr/data/15057999/openapi.do
# 3) 마이페이지 > 오픈API > 인증키 복사. 계정당 인증키 1개가 모든 승인 API에 공통 적용됨.
#    Decoding 키(원문)를 넣고 요청 시 URL 인코딩할 것. 두 키가 따로 보이면 Decoding 쪽.
# 트래픽: 마이홈 1,000/일, LH 10,000/일 (개발계정). 운영계정 전환 시 활용사례 등록 필요.
# LH 목록·상세 API도 이 키 하나로 호출한다. 승인은 데이터셋별로 따로 받아야 한다.
DATA_GO_KR_SERVICE_KEY=

# ── 카카오 (developers.kakao.com) ─────────────────────
# 1) 카카오계정 로그인 > [내 애플리케이션] > 애플리케이션 추가
# 2) [앱 설정 > 플랫폼 > Web] 에 사이트 도메인 등록 (http://localhost:5173)
# 3) [제품 설정 > 카카오맵] 활성화 (2026-07-21 이후 필수. 계정당 첫 앱만 무료 쿼터)
# 4) [앱 설정 > 앱 키] 에서
#    - JavaScript 키 → 프론트 지도 SDK (VITE_ 접두어로 브라우저 노출됨. 도메인 제한이 보호수단)
#    - REST API 키   → 서버 지오코딩 (Authorization: KakaoAK {키}). 절대 프론트 노출 금지
# 무료 쿼터: 지도 SDK 300,000/일, 주소→좌표 100,000/일 (2026-09 기준)
KAKAO_REST_API_KEY=

# ── SH 공고 (인증 불필요) ─────────────────────────────
# 공고 및 공지 게시판 목록. 유형 구분 없이 전량 수집한다 (RSS는 최근 29건만 줘서 과거 공고를 못 받는다)
SH_LIST_URL=https://www.i-sh.co.kr/main/lay2/program/S1T294C295/www/brd/m_241/list.do?multi_itm_seqs=1,2,4,8,16,32,64,256

# ── HUG 든든전세 (data.go.kr) ────────────────────────
# 1) https://www.data.go.kr/data/15143827/openapi.do 에서 [활용신청] (자동승인)
# 2) LINK 유형이라 포털이 아니라 HUG 자체 엔드포인트를 호출한다.
#    마이페이지 > 오픈API > 개발계정 상세에서 받은 "인증키 포함 전체 호출 URL"을 그대로 넣을 것.
# 모집기간이 아니면 [{"ERROR_CODE":"03","ERROR_MSG":"NO_DATA"}]가 오고, 수집기는 이를 0건으로 처리한다.
# 비워두면 HUG 수집 단계를 건너뛴다.
HUG_JEONSE_API_URL=

# ── OpenAI (공고문 PDF 단지 표 추출) ─────────────────
# 1) https://platform.openai.com 가입 > 좌측 [API keys] > Create new secret key
# 2) [Settings > Billing] 결제수단 등록 후 소액 충전 (선불, 최소 $5)
# 모델 gpt-5.6-luna 기준($0.20/$1.20 per 1M) 공고 1건 ≈ 15~20원. 월 1~2건이라 비용 무시 가능
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ── 로그인·권한 ──────────────────────────────────────
# 카카오 로그인: developers.kakao.com › 내 애플리케이션 › [제품 설정 > 카카오 로그인] 활성화 후
#   Redirect URI 등록: http://localhost:5173/api/auth/kakao/callback, https://<도메인>/api/auth/kakao/callback
#   동의항목: 카카오계정(이메일) 필수, 닉네임 선택. client_id는 위 KAKAO_REST_API_KEY 재사용
# [보안] 탭에서 Client Secret을 켰을 때만 아래 값 필요
KAKAO_CLIENT_SECRET=
# 세션 쿠키 서명 키. openssl rand -base64 32. 바꾸면 전원 로그아웃
SESSION_SECRET=
# 어드민 허용 카카오 계정 이메일 (쉼표 구분, 대소문자 무시)
ADMIN_EMAILS=

# ── 프론트 (vite envDir=루트, VITE_ 접두어만 브라우저 노출) ──
VITE_API_BASE=/api
# 카카오 [앱 설정 > 앱 키]의 JavaScript 키 (REST 키 아님)
VITE_KAKAO_JS_KEY=

# ── 운영 (docker-compose.prod.yml 전용. 로컬 개발엔 불필요) ──
# GH_OWNER=devcdd                 # ghcr.io/<owner>/zipzom-api 이미지 경로. 소문자
# POSTGRES_USER=zipzom
# POSTGRES_PASSWORD=바꿀것
# POSTGRES_DB=zipzom
# WEB_ORIGIN=https://<도메인>     # nginx가 /api를 같은 origin으로 프록시하므로 사실상 미사용
# 운영 .env엔 SESSION_SECRET·ADMIN_EMAILS·(KAKAO_CLIENT_SECRET)도 필요
# PORT·DATABASE_URL·VITE_KAKAO_JS_KEY 는 운영 .env에 두지 않는다 (compose가 조립 / web 빌드 시 CI secret)
